# MongoDB connection string. Defaults to the docker-compose service name if unset.
MONGO_URI=mongodb://mongo:27017

# Database name to use within the MongoDB instance.
MONGO_DB_NAME=power_service

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# Secret key used to sign JWTs. This is a placeholder, not a real secret -
# generate your own (e.g. `openssl rand -hex 32`) for any non-local use.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Hours until an issued JWT expires.
JWT_EXPIRATION_HOURS=24
